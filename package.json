{
  "name": "trademark-engine",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel --filter=@trademark-engine/api --filter=@trademark-engine/dashboard",
    "dev:api": "pnpm --filter @trademark-engine/api dev",
    "dev:dashboard": "pnpm --filter @trademark-engine/dashboard dev",
    "dev:worker": "pnpm --filter @trademark-engine/worker dev",
    "dev:phonetic": "pnpm --filter @trademark-engine/phonetic-service dev",
    "db:migrate": "pnpm --filter @trademark-engine/database migrate",
    "db:generate": "pnpm --filter @trademark-engine/database generate",
    "corpus:bridge": "tsx scripts/bridge-100k.ts",
    "corpus:bridge-100k": "tsx scripts/bridge-100k.ts",
    "corpus:purge-statuses": "tsx scripts/purge-non-allowlist-statuses.ts",
    "corpus:preprocess": "tsx scripts/preprocess-100k.ts",
    "corpus:preprocess-100k": "tsx scripts/preprocess-100k.ts",
    "bench:scan-timing": "tsx scripts/benchmark-scan-timing.ts"
  },
  "dependencies": {
    "@trademark-engine/corpus-bridge": "workspace:*",
    "@trademark-engine/database": "workspace:*",
    "@trademark-engine/domain": "workspace:*",
    "@trademark-engine/ngrams": "workspace:*",
    "@trademark-engine/normalization": "workspace:*",
    "@trademark-engine/phonetics": "workspace:*",
    "@trademark-engine/token-analysis": "workspace:*",
    "@trademark-engine/transliteration": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
