DATABASE_URL=postgres://trademark:trademark@localhost:5433/trademark_engine
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 0 = uncapped full allowlist (REGISTERED+ACCEPTED); 100000 = proof subset
CORPUS_LIMIT=0
CORPUS_DATABASE_URL=
ENGINE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3000
# Fixture-only sample bridge via POST /api/corpus-bridge (never for normal scans)
# ALLOW_SAMPLE_BRIDGE=1

# Anthropic post-engine attorney analysis (top ≤1000 → top 5)
# Off by default to keep local scans cheap; set ENABLED=1 when you want live calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ATTORNEY_ANALYSIS_ENABLED=0
ATTORNEY_ANALYSIS_CANDIDATE_LIMIT=1000
ATTORNEY_ANALYSIS_TOP_N=10
ATTORNEY_ANALYSIS_TEMPERATURE=0
